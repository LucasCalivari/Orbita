# Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de datos (coincide con docker-compose.yml)
DATABASE_URL=postgresql://orbita:orbita@localhost:5432/orbita

# Sesión (se usa a partir de CU-02)
JWT_SECRET=cambiar_por_un_valor_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Proveedores sociales (CU-01 / CU-02) - completar con las credenciales de cada consola
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
