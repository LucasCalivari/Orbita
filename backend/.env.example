# Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de datos (coincide con docker-compose.yml)
DATABASE_URL=postgresql://orbita:orbita@localhost:5432/orbita

# Sesión (cookie firmada; la usan CU-01 y CU-02)
JWT_SECRET=cambiar_por_un_valor_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# Google OAuth (CU-01 / CU-02) - RF-01: acceso solo con cuenta de Google.
# Se obtienen en Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth (aplicación web).
# En la consola, agregar GOOGLE_REDIRECT_URI como "URI de redireccionamiento autorizado".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
